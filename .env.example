# Google AI Studio에서 발급받은 Gemini API Key
GEMINI_API_KEY=

# 사용할 Gemini 모델 ID
GEMINI_MODEL=

# 선택 설정: 변경하지 않으면 아래 값이 사용됩니다.
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30

# Ollama Local LLM TXT 번역 설정
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300
